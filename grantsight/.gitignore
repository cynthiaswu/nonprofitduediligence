# IRS indexes and downloaded bulk files. Hundreds of MB, rebuildable in
# minutes, and GitHub rejects files over 100 MB.
data/
*.sqlite3
*.sqlite3.building

# Cached HTTP responses
.cache/

# Build artifacts
*.zip
*.part
dist/
build/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Secrets belong in the host's environment, never in the repo
.env
.env.*
